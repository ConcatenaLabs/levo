# Every setting levod reads. Copy to /etc/sequentia/levod.env, fill in the
# blanks, and never commit the result: it holds the session secret and the
# node's credentials.

LEVOD_HOST=127.0.0.1
LEVOD_PORT=8099

# The built app, and the state file. Keep the state outside the checkout.
LEVOD_WEBROOT=/path/to/levo/web/dist
LEVOD_STATE=/var/lib/levo/levo-state.json

# Session-token key. Without it every restart signs everyone out.
LEVOD_SECRET=

# The Sequentia node levod reads. User/password, or a cookie file.
LEVOD_RPC_URL=http://127.0.0.1:18776
LEVOD_RPC_USER=
LEVOD_RPC_PASSWORD=
#LEVOD_RPC_COOKIE=~/.elements/testnet3/.cookie

# The asset every sale is priced in, its label in the node's rate table, and
# how many decimal places it divides into. Every price, cap and quote is
# denominated in it, and levod refuses to start on anything that is not a
# 64-character asset id. The values this project's own testnet deployment uses
# are in the README, under Deployment.
# levod will not start until this is filled in.
LEVOD_PAYMENT_ASSET=
LEVOD_PAYMENT_LABEL=
#LEVOD_PAYMENT_DECIMALS=8

# The label the node's fee exchange-rate table uses for bitcoin, which is what
# a BTC quote is derived from. On this chain that row is the pegged asset's.
#LEVOD_BTC_RATE_LABEL=SBTC

# Address prefix: tb on the testnet, bc on mainnet.
LEVOD_HRP=tb

# Links the site shows: an esplora-style explorer, and the rest of your own
# deployment. Both are optional; the site does without them.
LEVOD_EXPLORER_URL=
LEVOD_LINKS=

# The staking token's ticker in the interface. levod derives it from the chain
# the node reports (tSEQ on the testnet), so set it only to override that.
#LEVOD_STAKE_LABEL=tSEQ

# The tier table, in whole SEQ and whole units of the payment asset. Omit it
# for the supply-share defaults in levod/tiers.py. A blurb is optional and says
# what the tier MEANS: the threshold and the cap are shown beside it from these
# numbers, in the deployment's own units, so a blurb should not repeat them.
#LEVOD_TIERS=[{"name":"Visitor","min_stake":0,"cap":0},{"name":"Contributor","min_stake":40000,"cap":1000},{"name":"Backer","min_stake":50000,"cap":10000},{"name":"Founder","min_stake":1000000,"cap":100000,"may_list":true}]

# The public address this Levo is reached at. It goes into the statement a
# wallet is asked to sign, so behind a proxy it must be the public URL rather
# than the Host header the proxy passes on -- and it must be YOUR address: a
# wallet showing someone else's is the confusion a signing statement exists to
# prevent.
LEVOD_ORIGIN=

# Where THIS deployment's source is, linked from the site so a visitor can
# check what it runs. Point it at your own fork if you run one: the default is
# upstream, which is not what a fork is serving.
#LEVOD_SOURCE_URL=https://github.com/ConcatenaLabs/levo

# Accounts that may hide a listing from the board or put a notice on its page:
# compressed public keys, comma or space separated. Empty means nobody can.
#LEVOD_OPERATORS=

# Peers whose X-Forwarded-For is believed, for rate limiting. Loopback by
# default, which is where a reverse proxy on the same host connects from. Set
# it empty when levod is exposed directly.
#LEVOD_TRUSTED_PROXIES=127.0.0.1 ::1

# What to call the chain when the node cannot be asked. levod asks the node and
# keeps asking until it answers, so this is only a fallback.
#LEVOD_CHAIN=test

# How often the watcher reconciles every sale against the chain.
LEVOD_WATCH_SECONDS=60

# Seconds the node's tip may be reused, which turns three round trips a page
# into one. Set it to 0 on a chain that mines on demand.
#LEVOD_CHAIN_TTL=2

# Per-client limits, per minute: signing in, the calls that write, and reads.
# Health is never limited, so an uptime check cannot trip them.
#LEVOD_AUTH_PER_MINUTE=30
#LEVOD_WRITES_PER_MINUTE=120
#LEVOD_READS_PER_MINUTE=600

# Log every request, health checks and static files included.
#LEVOD_VERBOSE=
