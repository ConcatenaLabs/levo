# Every setting levod reads. Copy to /etc/sequentia/levod.env, fill in the
# blanks, and never commit the result: it holds the session secret and the
# node's credentials.

LEVOD_HOST=127.0.0.1
LEVOD_PORT=8099

# The built app, and the state file. Keep the state outside the checkout.
LEVOD_WEBROOT=/root/sequentia/levo/web/dist
LEVOD_STATE=/var/lib/levo/levo-state.json

# Session-token key. Without it every restart signs everyone out.
LEVOD_SECRET=

# The Sequentia node levod reads. User/password, or a cookie file.
LEVOD_RPC_URL=http://127.0.0.1:18776
LEVOD_RPC_USER=
LEVOD_RPC_PASSWORD=
#LEVOD_RPC_COOKIE=/root/.elements/testnet3/.cookie

# The asset every sale is priced in, and its label in the node's rate table.
LEVOD_PAYMENT_ASSET=2a515539da5e6a60caa7766ecd65bac0c10d15717ddd2088844ba58f4d04b9de
LEVOD_PAYMENT_LABEL=USDX

# Address prefix: tb on the testnet, bc on mainnet.
LEVOD_HRP=tb

# Links the site shows: an esplora-style explorer, and the rest of the deployment.
LEVOD_EXPLORER_URL=https://sequentiatestnet.com/explorer
LEVOD_LINKS={"Wallet":"https://sequentiatestnet.com/wallet/","Faucet":"https://sequentiatestnet.com/faucet","Staking pools":"https://sequentiatestnet.com/pools/"}

# The tier table, in whole SEQ and whole units of the payment asset. Omit it
# for the supply-share defaults in levod/tiers.py.
#LEVOD_TIERS=[{"name":"Visitor","min_stake":0,"cap":0},{"name":"Contributor","min_stake":40000,"cap":1000},{"name":"Backer","min_stake":50000,"cap":10000},{"name":"Founder","min_stake":1000000,"cap":100000,"may_list":true}]

LEVOD_WATCH_SECONDS=60
