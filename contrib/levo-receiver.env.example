# The project's Lightning receiver (levod/receiver.py). Copy to
# /etc/sequentia/levo-receiver.env and fill in. It holds no secret itself: the
# key lives in the file named below, readable by root alone.

# The receiver key's 32-byte secret, hex, in a file of its own (chmod 600).
# Its x-only public key is the sale's receiver_xonly; `python3 levod/receiver.py
# --help` says how the pair is used, and `bin/levo keygen` makes one.
LEVO_RECEIVER_KEY_FILE=/var/lib/levo-receiver/key

# The project's Lightning node on the Bitcoin network buyers pay on.
LEVO_RECEIVER_LIGHTNING=lightning-cli --network=testnet4

# The levod that lists the sales, and the sales this receiver serves.
LEVO_RECEIVER_LEVO=http://127.0.0.1:8099
LEVO_RECEIVER_SLUGS=

# Where forfeited bonds are paid, and the Sequentia node it reads and
# broadcasts through. HRP is the chain's address prefix.
LEVO_RECEIVER_BOND_TO=
LEVO_RECEIVER_HRP=tb
LEVO_RECEIVER_RPC_URL=http://127.0.0.1:18776
LEVO_RECEIVER_RPC_USER=
LEVO_RECEIVER_RPC_PASSWORD=

LEVO_RECEIVER_STATE=/var/lib/levo-receiver/state.json
LEVO_RECEIVER_PORT=8098
LEVO_RECEIVER_INVOICE_EXPIRY=600
