# Where a Levo alert goes. Copy to /etc/sequentia/levo-alert.env, mode 0600,
# and fill in the topic; contrib/README.md says what reads it. Without this
# file every alert goes to the journal and nowhere else.
NTFY_TOPIC=                          # required: a name nobody guesses; subscribe at https://ntfy.sh/<it>
#NTFY_URL=https://ntfy.sh            # optional: a self-hosted ntfy
#ALERT_PREFIX=levo                   # optional: the message's title
