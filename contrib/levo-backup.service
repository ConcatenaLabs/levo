[Unit]
Description=Copy levod's state file
# A backup that stops working is silent until it is needed, so a failure
# tells a person: see contrib/levo-alert.sh for the push topic.
OnFailure=levo-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/sequentia/levod.env
ExecStart=/root/sequentia/levo/contrib/levo-backup.sh
SyslogLevelPrefix=yes
# The same fence as levod's, for a script that reads one file and writes one
# directory.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/levo
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
