[Unit]
Description=Levo launchpad (levod)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The checkout the box pulls from GitHub. Never edit source here.
WorkingDirectory=/root/sequentia/levo
# Every LEVOD_* setting, including the secret and the node credentials.
EnvironmentFile=/etc/sequentia/levod.env
ExecStart=/usr/bin/python3 /root/sequentia/levo/levod/server.py
Restart=always
RestartSec=5
# levod exits 78 when the state file cannot be read. Restarting cannot fix
# that, and a loop would bury the message saying to restore a backup.
RestartPreventExitStatus=78
# levod saves on every mutation and stops cleanly on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
# levod prefixes its own lines with a syslog priority, so `journalctl -u levod
# -p err` shows what went wrong and nothing else.
SyslogLevelPrefix=yes
# A failure tells a person: see contrib/levo-alert.sh for the push topic.
OnFailure=levo-alert@%n.service

# What levod may touch. It is a Python process serving HTTP that reads a
# checkout, an environment file and a node's RPC, and writes one directory. It
# runs as root only because the checkout lives under /root, which no other
# user can reach; with these lines a root process is still a root process,
# but one that holds no capabilities, cannot gain any, sees the rest of the
# filesystem read-only and its own temp directory, and can open only the
# sockets a web service needs. `systemd-analyze security levod` scores it.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/levo
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
