#!/usr/bin/env python3
"""levo -- drive a Levo sale from the command line, against your own node.

The web app hands you an unsigned transaction because levod holds no keys. If
you run a Sequentia node, this does the rest: it picks unblinded inputs, builds
the transaction, signs your inputs with your wallet, and broadcasts.

    levo sales                              list what is open
    levo show <slug>                        the terms, and the address to check
    levo buy <slug> --tokens 100            buy, end to end
    levo lock <slug> --atoms 100000000      fund a sale you are listing
    levo reclaim <slug> --to <address>      sweep what did not sell, after close

Every command talks to a levod over HTTP and to your node over JSON-RPC. It
never sends a key anywhere: signing happens in your own wallet, locally.
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "levod"))

import address as ADDR  # noqa: E402

LEVO_URL = os.environ.get("LEVO_URL", "http://127.0.0.1:8099")
CLI = os.environ.get("SEQUENTIA_CLI", "sequentia-cli")
DATADIR = os.environ.get("SEQUENTIA_DATADIR", "")
WALLET = os.environ.get("SEQUENTIA_WALLET", "")


class Fail(SystemExit):
    def __init__(self, msg):
        super().__init__("levo: %s" % msg)


def node(*args):
    cmd = [CLI]
    if DATADIR:
        cmd.append("-datadir=%s" % DATADIR)
    if WALLET:
        cmd.append("-rpcwallet=%s" % WALLET)
    cmd += [str(a) for a in args]
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        raise Fail("node call %s failed: %s" % (args[0], p.stderr.strip() or p.stdout.strip()))
    out = p.stdout.strip()
    try:
        return json.loads(out)
    except ValueError:
        return out


def api(method, path, body=None, token=None):
    req = urllib.request.Request(
        LEVO_URL + path,
        data=json.dumps(body).encode() if body is not None else None,
        method=method, headers={"Content-Type": "application/json"})
    if token:
        req.add_header("Authorization", "Bearer " + token)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            raise Fail(json.loads(e.read())["error"])
        except (ValueError, KeyError):
            raise Fail("HTTP %s from %s" % (e.code, path))
    except Exception as e:
        raise Fail("cannot reach levod at %s: %s" % (LEVO_URL, e))


def sign_in():
    """Log in the way the web app does: sign levod's challenge with the node.

    Set LEVO_SIGN_WIF to sign with a specific key instead of a wallet address.
    A staker who signs in with their STAKING key is recognised immediately --
    the login has already proved control of it, so there is nothing left to
    link.
    """
    token_file = Path(os.path.expanduser("~/.levo-session"))
    if token_file.is_file():
        tok = token_file.read_text().strip()
        try:
            api("GET", "/api/me", token=tok)
            return tok
        except Fail:
            pass
    ch = api("POST", "/api/auth/challenge")
    wif = os.environ.get("LEVO_SIGN_WIF")
    if wif:
        sig = node("signmessagewithprivkey", wif, ch["message"])
    else:
        addr = node("getnewaddress", "levo-login")
        sig = node("signmessage", addr, ch["message"])
    r = api("POST", "/api/auth/verify", {"message": ch["message"], "signature": sig})
    token_file.write_text(r["token"])
    try:
        token_file.chmod(0o600)
    except OSError:
        pass
    print("signed in as %s" % r["account"])
    return r["token"]


def unblinded_inputs(asset_hex, need_atoms):
    """Pick explicit outputs covering `need_atoms` of an asset.

    A covenant fill has to be readable by the covenant, so confidential outputs
    are no use here however much they hold.
    """
    utxos = node("listunspent", 0, 9999999)
    picked, total = [], 0
    for u in utxos:
        if (u.get("asset") or "").lower() != asset_hex.lower():
            continue
        if u.get("amountcommitment") or u.get("assetcommitment"):
            continue                                   # confidential: unusable
        atoms = int(round(float(u["amount"]) * 100_000_000))
        picked.append({"txid": u["txid"], "vout": int(u["vout"])})
        total += atoms
        if total >= need_atoms:
            return picked, total
    raise Fail(
        "not enough UNBLINDED %s to cover %d atoms (found %d). Send some to an "
        "unblinded address first: a covenant reads the amounts it checks, so it "
        "cannot be filled with confidential outputs."
        % (asset_hex[:12], need_atoms, total))


def cmd_sales(args):
    for p in api("GET", "/api/projects")["projects"]:
        s = p.get("sale") or {}
        print("%-18s %-6s %-9s %s" % (
            p["slug"], p["ticker"], s.get("status", "-"),
            s.get("address") or p.get("address") or ""))


def cmd_show(args):
    p = api("GET", "/api/projects/%s" % args.slug)
    print(json.dumps(p, indent=2))


def cmd_lock(args):
    tok = sign_in()
    p = api("GET", "/api/projects/%s" % args.slug)
    sale = p["sale"]
    addr = p.get("address") or ADDR.from_script_pubkey(sale["script_pubkey"])
    atoms = int(args.atoms or sale["terms"]["total_atoms"])
    print("sending %d atoms of %s to %s" % (atoms, sale["terms"]["token_asset"], addr))
    txid = node("-named", "sendtoaddress", "address=%s" % addr,
                "amount=%.8f" % (atoms / 100_000_000),
                "assetlabel=%s" % args.asset_label,
                "fee_asset_label=%s" % args.fee_asset_label)
    raw = node("getrawtransaction", txid, 1)
    vout = next((o["n"] for o in raw["vout"]
                 if o.get("scriptPubKey", {}).get("hex") == sale["script_pubkey"]), None)
    if vout is None:
        raise Fail("funded %s but could not find the covenant output" % txid)
    api("POST", "/api/projects/%s/lock" % args.slug, {"txid": txid, "vout": vout}, tok)
    print("locked at %s:%d -- the sale is open" % (txid, vout))


def cmd_buy(args):
    tok = sign_in()
    p = api("GET", "/api/projects/%s" % args.slug)
    sale = p["sale"]
    token_atoms = int(round(float(args.tokens) * 100_000_000))

    plan = api("POST", "/api/projects/%s/buy" % args.slug,
               {"token_atoms": token_atoms, "rail": args.rail}, tok)
    print("buying %s %s for %d atoms of the payment asset"
          % (args.tokens, p["ticker"], plan["payment_atoms"]))

    pay_asset = sale["terms"]["payment_asset"]
    fee_atoms = int(args.fee)
    ins, _ = unblinded_inputs(pay_asset, plan["payment_atoms"] + fee_atoms)

    dest = args.to or node("getnewaddress", "levo-buy")
    dest_spk = node("getaddressinfo", dest)["scriptPubKey"]
    change = args.change or dest
    change_spk = node("getaddressinfo", change)["scriptPubKey"]

    built = api("POST", "/api/projects/%s/transaction" % args.slug, {
        "token_atoms": token_atoms,
        "buyer": {"token_script_pubkey": dest_spk,
                  "change_script_pubkey": change_spk,
                  "inputs": ins, "fee_atoms": fee_atoms,
                  "fee_asset": pay_asset}}, tok)

    signed = node("signrawtransactionwithwallet", built["unsigned_tx_hex"])
    if not signed.get("complete"):
        raise Fail("your wallet could not sign every input: %s" % signed.get("errors"))
    check = node("testmempoolaccept", json.dumps([signed["hex"]]))
    if not check or not check[0].get("allowed"):
        raise Fail("the chain would reject this: %s"
                   % (check[0].get("reject-reason") if check else "unknown"))
    if args.dry_run:
        print("would broadcast %s (accepted by testmempoolaccept)" % built["txid"])
        return
    txid = node("sendrawtransaction", signed["hex"])
    print("bought. %s" % txid)
    # The purchase is on chain now. Recording it against your allocation is a
    # bookkeeping step, so a failure here is worth saying out loud but must not
    # be reported as a failed purchase.
    try:
        api("POST", "/api/projects/%s/confirm" % args.slug,
            {"txid": txid, "token_atoms": token_atoms,
             "payment_atoms": plan["payment_atoms"]}, tok)
    except SystemExit as e:
        print("note: the purchase succeeded, but recording it against your "
              "allocation did not (%s)" % e)


def cmd_reclaim(args):
    tok = sign_in()
    p = api("GET", "/api/projects/%s" % args.slug)
    sale = p["sale"]
    dest = args.to or node("getnewaddress", "levo-reclaim")
    dest_spk = node("getaddressinfo", dest)["scriptPubKey"]
    fee_atoms = int(args.fee)
    ins, _ = unblinded_inputs(sale["terms"]["payment_asset"], fee_atoms)
    r = api("POST", "/api/projects/%s/reclaim" % args.slug, {
        "destination_script_pubkey": dest_spk,
        "fee_inputs": ins, "fee_atoms": fee_atoms,
        "fee_asset": sale["terms"]["payment_asset"]}, tok)
    print("sighash %s" % r["sighash"])
    print("sign it with the reclaim key (%s), add [sig, leaf, control block] to "
          "input 0, then sign your fee inputs and broadcast." % r["signs_with"])
    print(json.dumps({k: r[k] for k in ("leaf", "control_block", "locktime",
                                        "unsigned_tx_hex", "txid")}, indent=2))


def main():
    ap = argparse.ArgumentParser(prog="levo", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("sales").set_defaults(fn=cmd_sales)

    sh = sub.add_parser("show"); sh.add_argument("slug"); sh.set_defaults(fn=cmd_show)

    lk = sub.add_parser("lock")
    lk.add_argument("slug"); lk.add_argument("--atoms", type=int)
    lk.add_argument("--asset-label", required=True)
    lk.add_argument("--fee-asset-label", default="bitcoin")
    lk.set_defaults(fn=cmd_lock)

    b = sub.add_parser("buy")
    b.add_argument("slug"); b.add_argument("--tokens", required=True)
    b.add_argument("--rail", default="usdx")
    b.add_argument("--fee", type=int, default=100000)
    b.add_argument("--to"); b.add_argument("--change")
    b.add_argument("--dry-run", action="store_true")
    b.set_defaults(fn=cmd_buy)

    rc = sub.add_parser("reclaim")
    rc.add_argument("slug"); rc.add_argument("--to")
    rc.add_argument("--fee", type=int, default=100000)
    rc.set_defaults(fn=cmd_reclaim)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
