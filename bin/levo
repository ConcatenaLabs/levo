#!/usr/bin/env python3
"""levo -- drive a Levo sale from the command line, against your own node.

The web app hands you an unsigned transaction because levod holds no keys. If
you run a Sequentia node, this does the rest: it picks unblinded inputs, builds
the transaction, signs your inputs with your wallet, and broadcasts.

    levo sales                              list what is listed
    levo show <slug>                        the terms, and the address to check
    levo verify <slug>                      rebuild the sale address and compare it
                                            with the funded output on your node
    levo whoami                             the account you are signed in as
    levo link                               prove a staking key for your account
    levo keygen                             a reclaim key pair for a new listing
    levo create terms.json                  list a project from a JSON file
                                            (levo create --example prints one)
    levo lock <slug>                        fund a sale you are listing
    levo buy <slug> --tokens 100            buy, end to end
    levo reclaim <slug> --to <address>      sweep what did not sell, after close
    levo withdraw <slug>                    remove an unfunded listing of yours
    levo record <slug> --txid <id> --tokens 100
                                            record a purchase Levo has not seen
    levo terms <slug> --out sale.json       keep what rebuilds the sale without Levo
    levo rescue --terms sale.json           reclaim from that file alone, no Levo
    levo flag <slug> --notice "..."         operator: a notice on a listing

Every command talks to a levod over HTTP and to your node over JSON-RPC. It
never sends a key anywhere: signing happens in your own wallet, locally.

Environment:
    LEVO_URL            the levod to talk to (default http://127.0.0.1:8099)
    LEVO_SESSION        where to keep the signed-in session
                        (default ~/.levo-session)
    SEQUENTIA_CLI       the node's CLI binary (default sequentia-cli on PATH)
    SEQUENTIA_DATADIR   passed as -datadir, for a node in a non-default place
    SEQUENTIA_WALLET    passed as -rpcwallet, when several wallets are loaded
    LEVO_SIGN_WIF       sign in with this key instead of a wallet address. A
                        staker who signs in with the staking key's WIF is
                        recognised at once; there is nothing to link.
    LEVO_RECLAIM_KEY    the 32-byte hex reclaim secret, for `levo reclaim`
                        (or pass --reclaim-key)

Sign-in identity: without LEVO_SIGN_WIF, the first sign-in creates a legacy
address labelled "levo-login" in your wallet and every later sign-in reuses
it, so your account stays the same key. The node's message signing works with
legacy addresses only.
"""

import argparse
import json
import os
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.request
from decimal import Decimal
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "levod"))

import address as ADDR  # noqa: E402
import covenant as C  # noqa: E402
import sale as S_MOD  # noqa: E402
import units as U  # noqa: E402

LEVO_URL = os.environ.get("LEVO_URL", "http://127.0.0.1:8099").rstrip("/")
CLI = os.environ.get("SEQUENTIA_CLI", "sequentia-cli")
DATADIR = os.environ.get("SEQUENTIA_DATADIR", "")
WALLET = os.environ.get("SEQUENTIA_WALLET", "")
# Where the signed-in session is kept. One file, which remembers which levod it
# belongs to; LEVO_SESSION moves it, for a machine where several people or
# several deployments share an account.
SESSION_FILE = Path(os.path.expanduser(
    os.environ.get("LEVO_SESSION") or "~/.levo-session"))


class Fail(SystemExit):
    def __init__(self, msg):
        super().__init__("levo: %s" % msg)


def node(*args, **named):
    """Call the node's CLI. Named arguments go through -named, which the
    long-tailed Elements RPCs need to be readable."""
    cmd = [CLI]
    if DATADIR:
        cmd.append("-datadir=%s" % DATADIR)
    if WALLET:
        cmd.append("-rpcwallet=%s" % WALLET)
    if named:
        cmd += ["-named", str(args[0])] + ["%s=%s" % (k, _arg(v)) for k, v in named.items()]
    else:
        cmd += [_arg(a) for a in args]
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        raise Fail("node call %s failed: %s" % (args[0], p.stderr.strip() or p.stdout.strip()))
    out = p.stdout.strip()
    try:
        return json.loads(out, parse_float=Decimal)
    except ValueError:
        return out


def _arg(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (dict, list)):
        return json.dumps(v)
    return str(v)


def api(method, path, body=None, token=None):
    req = urllib.request.Request(
        LEVO_URL + path,
        data=json.dumps(body).encode() if body is not None else None,
        method=method, headers={"Content-Type": "application/json"})
    if token:
        req.add_header("Authorization", "Bearer " + token)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            raise Fail(json.loads(e.read())["error"])
        except (ValueError, KeyError):
            raise Fail("HTTP %s from %s" % (e.code, path))
    except urllib.error.URLError as e:
        raise Fail("cannot reach levod at %s: %s" % (LEVO_URL, e))


def atoms(v):
    """Atoms for an amount the node reported, exactly."""
    return int((Decimal(str(v)) * 100_000_000).to_integral_value())


# --- signing in -----------------------------------------------------------------

def _session():
    if SESSION_FILE.is_file():
        try:
            return json.loads(SESSION_FILE.read_text())
        except ValueError:
            return {}
    return {}


def _save_session(d):
    SESSION_FILE.write_text(json.dumps(d))
    try:
        SESSION_FILE.chmod(0o600)
    except OSError:
        pass


def login_address():
    """The wallet address that signs Levo's challenges: one legacy address,
    created once and reused, so the account is the same key every time."""
    sess = _session()
    addr = sess.get("address")
    if addr:
        return addr
    labelled = {}
    try:
        labelled = node("getaddressesbylabel", "levo-login") or {}
    except Fail:
        pass
    for a in labelled:
        info = node("getaddressinfo", a)
        if info.get("isscript") is False and info.get("iswitness") is False:
            return a
    return node("getnewaddress", "levo-login", "legacy")


def sign_in():
    """Log in the way the web app does: sign levod's challenge with the node.

    Set LEVO_SIGN_WIF to sign with a specific key instead of a wallet address.
    A staker who signs in with their STAKING key is recognised immediately --
    the login has already proved control of it, so there is nothing left to
    link.
    """
    sess = _session()
    tok = sess.get("token")
    if tok and sess.get("url") == LEVO_URL:
        try:
            api("GET", "/api/me", token=tok)
            return tok
        except Fail:
            pass
    ch = api("POST", "/api/auth/challenge")
    wif = os.environ.get("LEVO_SIGN_WIF")
    body = {"message": ch["message"]}
    if wif:
        body["signature"] = node("signmessagewithprivkey", wif, ch["message"])
    else:
        addr = login_address()
        body["signature"] = node("signmessage", addr, ch["message"])
        body["address"] = addr
    r = api("POST", "/api/auth/verify", body)
    _save_session({"url": LEVO_URL, "token": r["token"], "account": r["account"],
                   "address": None if wif else body["address"]})
    prior = sess.get("account")
    if prior and prior != r["account"]:
        print("note: signed in as %s; the last session here was %s" % (r["account"], prior),
              file=sys.stderr)
    else:
        print("signed in as %s" % r["account"], file=sys.stderr)
    if not wif:
        me = api("GET", "/api/me", token=r["token"])
        if me["tier"]["cap_atoms"] == 0 and not me["keys"]:
            print("note: this account holds no proven stake. To sign in with your "
                  "staking key set LEVO_SIGN_WIF to its WIF, or run `levo link`.",
                  file=sys.stderr)
    return r["token"]


def unblinded_inputs(asset_hex, need_atoms):
    """Pick explicit outputs covering `need_atoms` of an asset.

    A covenant fill has to be readable by the covenant, so confidential outputs
    are no use here however much they hold.
    """
    if need_atoms <= 0:
        return [], 0
    utxos = node("listunspent", 0, 9999999)
    picked, total = [], 0
    for u in sorted(utxos, key=lambda x: -Decimal(str(x["amount"]))):
        if (u.get("asset") or "").lower() != asset_hex.lower():
            continue
        if u.get("amountcommitment") or u.get("assetcommitment"):
            continue                                   # confidential: unusable
        picked.append({"txid": u["txid"], "vout": int(u["vout"])})
        total += atoms(u["amount"])
        if total >= need_atoms:
            return picked, total
    raise Fail(
        "not enough UNBLINDED %s to cover %s (found %s). Send some to an "
        "unblinded address first: a covenant reads the amounts it checks, so it "
        "cannot be filled with confidential outputs."
        % (asset_hex[:12], U.fmt(need_atoms), U.fmt(total)))


_CONFIG = {}


def config():
    """What this levod says about itself: the chain, the labels it uses, the
    address prefix. Read once, so a command that prints a ticker prints the one
    the deployment actually runs."""
    global _CONFIG
    if not _CONFIG:
        try:
            _CONFIG = api("GET", "/api/config") or {}
        except Exception:
            _CONFIG = {"payment": {"label": "the payment asset"},
                       "stake": {"label": "staked"}}
    return _CONFIG


def stake_label():
    return (config().get("stake") or {}).get("label") or "staked"


def payment_label():
    return (config().get("payment") or {}).get("label") or "the payment asset"


def resolve_asset(name):
    """An asset id from what a person typed. A label is what a wallet shows, so
    it is what they will type; the node's own table says which id it means."""
    text = str(name or "").strip()
    if len(text) == 64 and all(c in "0123456789abcdefABCDEF" for c in text):
        return text.lower()
    try:
        labels = node("dumpassetlabels") or {}
    except Exception:
        labels = {}
    for label, asset_id in labels.items():
        if str(label).lower() == text.lower():
            return str(asset_id).lower()
    raise Fail("%r is neither a 64-character asset id nor a label your node "
               "knows. `sequentia-cli dumpassetlabels` lists the labels it has."
               % text)


def _units(atoms, decimals=8):
    """Atoms as the decimal string a node's RPC expects, exactly."""
    atoms = int(atoms)
    sign = "-" if atoms < 0 else ""
    atoms = abs(atoms)
    base = 10 ** decimals
    return "%s%d.%0*d" % (sign, atoms // base, decimals, atoms % base)


def _payment_label(p):
    """What to call the payment asset in this CLI's own output. The sale says
    so when it can; otherwise the deployment does. Nothing is assumed here: a
    ticker typed into this file would be wrong on any Levo that prices in
    something else."""
    return (p or {}).get("payment_label") or payment_label()


# --- commands -----------------------------------------------------------------

def cmd_sales(args):
    r = api("GET", "/api/projects?status=%s&limit=%d&offset=%d"
            % (args.status, args.limit, args.offset))
    if not r["projects"]:
        print("nothing is listed" if args.status == "all"
              else "nothing is listed with status %s" % args.status)
        return
    shown = len(r["projects"])
    total = r.get("total", shown)
    for p in r["projects"]:
        s = p.get("sale") or {}
        status = (s.get("status") or "-").replace("_", " ")
        print("%-20s %-6s %-10s %s" % (p["slug"], p["ticker"], status, p.get("address") or ""))
    if total > args.offset + shown:
        print("\n%d of %d shown. --offset %d for the next page."
              % (shown, total, args.offset + shown))


def cmd_show(args):
    print(json.dumps(api("GET", "/api/projects/%s" % args.slug), indent=2))


def cmd_whoami(args):
    tok = sign_in()
    me = api("GET", "/api/me", token=tok)
    print("account  %s" % me["account"])
    label = stake_label()
    print("tier     %s (%s staked)" % (me["tier"]["name"], U.fmt(me["stake_atoms"], 8, label)))
    for k in me["keys"]:
        print("key      %s  %s%s" % (k["staker_pubkey"], U.fmt(k["weight_atoms"], 8, label),
                                     "  (login key)" if k.get("is_login_key") else ""))
    if not me.get("staking_available", True):
        print("note     %s" % me["delegation_note"])


def cmd_verify(args):
    """The check every page asks the reader to make, done by this machine."""
    p = api("GET", "/api/projects/%s" % args.slug)
    sale = p.get("sale")
    if not sale:
        raise Fail("this project has no sale")
    terms = C.SaleTerms.from_json(sale["terms"])
    cov = C.derive(terms)
    hrp = p.get("address", "tb1")[:p.get("address", "tb1").rfind("1")] if p.get("address") else "tb"
    derived_addr = ADDR.from_script_pubkey(cov.spk_hex, hrp)
    okay = True
    print("terms          %s" % json.dumps(sale["terms"], sort_keys=True))
    print("derived spk    %s" % cov.spk_hex)
    print("published spk  %s" % sale["script_pubkey"])
    if cov.spk_hex != sale["script_pubkey"]:
        okay = False
        print("MISMATCH: the published scriptPubKey is not what the published terms derive")
    print("derived addr   %s" % derived_addr)
    print("published addr %s" % p.get("address"))
    if p.get("address") and derived_addr != p["address"]:
        okay = False
        print("MISMATCH: the published address is not what the terms derive")
    f = sale.get("funding")
    if f:
        out = node("gettxout", f["txid"], int(f["vout"]), True)
        if not out:
            print("funding        %s:%s is not unspent on your node (spent, or not seen)" % (f["txid"], f["vout"]))
            okay = False
        else:
            spk = (out.get("scriptPubKey") or {}).get("hex")
            asset = (out.get("asset") or "").lower()
            print("on chain       spk %s" % spk)
            print("               asset %s, %s, %s confirmations"
                  % (asset, U.fmt(atoms(out.get("value", 0))), out.get("confirmations", 0)))
            if spk != cov.spk_hex:
                okay = False
                print("MISMATCH: the funded output is not at the derived address")
            if asset != terms.token_asset:
                okay = False
                print("MISMATCH: the funded output holds a different asset from the terms")
    else:
        print("funding        none published; the sale is a draft")
    print("internal key   NUMS (no key path)")
    # The address is made of some of the terms and not others, and saying "these
    # terms" without that distinction claims the chain enforces an amount it
    # never sees.
    print("committed      %s" % ", ".join(C.COMMITTED_TERMS))
    print("not committed  %s -- Levo checked the amount for sale against the"
          % ", ".join(C.PUBLISHED_TERMS))
    print("               chain when it accepted the lock; the covenant sells")
    print("               whatever it holds")
    if f and okay:
        held = atoms(out.get("value", 0))
        want = int(sale["terms"].get("total_atoms") or 0)
        sold = int(sale.get("sold_atoms") or 0)
        if want and held + sold < want:
            print("NOTE: the covenant holds %s and Levo records %s sold, which is "
                  "less than the %s this sale published"
                  % (U.fmt(held), U.fmt(sold), U.fmt(want)))
    print("RESULT         %s" % ("OK: the covenant at this address enforces exactly "
                                 "the committed terms above" if okay
                                 else "FAILED: do not buy from this listing"))
    return 0 if okay else 1


def cmd_link(args):
    tok = sign_in()
    pk = args.pubkey
    if not pk:
        if not args.address:
            raise Fail("give --pubkey <33-byte hex> or --address <the address whose key staked>")
        pk = node("getaddressinfo", args.address).get("pubkey")
        if not pk:
            raise Fail("your wallet does not hold the key behind %s" % args.address)
    ch = api("POST", "/api/stake/challenge", {"staker_pubkey": pk}, tok)
    if args.wif:
        sig = node("signmessagewithprivkey", args.wif, ch["message"])
    elif args.address:
        sig = node("signmessage", args.address, ch["message"])
    else:
        raise Fail("to sign the statement give --address (a legacy address of that key in "
                   "your wallet) or --wif")
    st = api("POST", "/api/stake/link", {"message": ch["message"], "signature": sig,
                                         "staker_pubkey": pk}, tok)
    print("linked. tier %s, %s staked" % (st["tier"]["name"],
                                          U.fmt(st["stake_atoms"], 8, stake_label())))


def cmd_keygen(args):
    """A fresh reclaim key. Levo never sees it; keep it where you keep money."""
    import secp256k1 as K
    sec = int.from_bytes(secrets.token_bytes(32), "big") % K.N
    if sec == 0:
        sec = 1
    print(json.dumps({
        "reclaim_secret_hex": "%064x" % sec,
        "reclaim_xonly": K.xonly_pubkey(sec).hex(),
        "keep": "the secret is the only thing that can take unsold tokens back "
                "after the close. Store it offline; put only reclaim_xonly in the listing.",
    }, indent=2))


EXAMPLE_LISTING = {
    "project": {
        "slug": "helios-grid",
        "name": "Helios Grid",
        "ticker": "HLX",
        "decimals": 8,
        "summary": "One line, shown on the board.",
        "description": "The long text on the sale page. Blank lines separate paragraphs.",
        "links": {"Website": "https://example.com"},
    },
    "terms": {
        "token_asset": "the 64-hex asset id of the token you are selling",
        "price_num": 1,
        "price_den": 4,
        "min_lot": 100000000,
        "total_atoms": 100000000000,
        "close_locktime": 1800000000,
        "treasury_address": "the address buyers' payments land at",
        "reclaim_xonly": "the 32-byte x-only public key from `levo keygen`",
    },
}


def cmd_create(args):
    if args.example:
        print(json.dumps(EXAMPLE_LISTING, indent=2))
        print("\n# price_num/price_den are payment atoms per token atom: 1/4 is"
              "\n# 0.25 payment units per whole token at 8 decimals."
              "\n# min_lot and total_atoms are ATOMS of the token."
              "\n# close_locktime is a unix time above 500000000, or a block"
              "\n# height below it. It is when the RECLAIM path opens.",
              file=sys.stderr)
        return
    if not args.file:
        raise Fail("give the listing file, or `levo create --example` to print one")
    tok = sign_in()
    spec = json.loads(Path(args.file).read_text())
    if not isinstance(spec, dict) or "project" not in spec or "terms" not in spec:
        raise Fail("the file holds {\"project\": {...}, \"terms\": {...}}. "
                   "`levo create --example` prints one to start from")
    r = api("POST", "/api/projects", spec, tok)
    lock = r["lock"]
    print("listed %s" % r["project"]["slug"])
    print("send exactly %s of asset %s to %s" % (lock["amount"], lock["asset"], lock["address"]))
    print("then: levo lock %s" % r["project"]["slug"])
    if lock.get("price_reduced"):
        print("note: the price was stored in lowest terms (%s/%s); verify against the "
              "published terms" % (r["project"]["sale"]["terms"]["price_num"],
                                   r["project"]["sale"]["terms"]["price_den"]))


def _send_explicit(address, atoms_, asset, fee_asset):
    """Send an amount of an asset, leaving every output explicit.

    `sendtoaddress` blinds the change when the destination is not one of the
    wallet's own addresses -- and a sale address never is. The issuer's
    remaining balance then commits to its value instead of stating one, and a
    covenant cannot read it: the very next thing they try to do with those
    funds, buying from their own sale or paying a reclaim's fee, fails with
    "not enough UNBLINDED".

    Funding the transaction with a change address per asset keeps the whole
    thing explicit. The amount is formatted from atoms without a float in the
    middle: a float carries fifteen digits, an allocation can need more, and
    sending a different number of atoms than the sale published would strand
    the tokens at the address as an amount the covenant refuses.
    """
    raw = node("createrawtransaction", [], [{address: _units(atoms_), "asset": asset}])
    change = {a: node("getnewaddress") for a in {asset, fee_asset}}
    try:
        funded = node("fundrawtransaction", raw,
                      {"fee_asset": fee_asset, "changeAddress": change})
    except Fail as e:
        # An older node, or one that will not take a change address per asset.
        # Send it the ordinary way and say what that costs.
        print("note: this node would not fund the transaction with explicit "
              "change (%s), so the send is being made the ordinary way and "
              "your change will be confidential. Send it to one of your own "
              "addresses afterwards to get an explicit output back." % e)
        txid = node("sendtoaddress", address=address, amount=_units(atoms_),
                    assetlabel=asset, fee_asset_label=fee_asset)
        return txid, node("gettransaction", txid)["hex"]
    signed = node("signrawtransactionwithwallet", funded["hex"])
    if not signed.get("complete"):
        raise Fail("your wallet could not sign the funding transaction: %s"
                   % signed.get("errors"))
    return node("sendrawtransaction", signed["hex"]), signed["hex"]


def cmd_lock(args):
    tok = sign_in()
    p = api("GET", "/api/projects/%s" % args.slug)
    sale = p["sale"]
    total = sale["terms"].get("total_atoms")
    if args.atoms is None and total is None:
        raise Fail("this sale publishes no total; pass --atoms")
    amount = int(args.atoms if args.atoms is not None else total)
    addr = p.get("address") or ADDR.from_script_pubkey(sale["script_pubkey"])
    fee_asset = args.fee_asset or sale["terms"]["payment_asset"]
    if args.txid:
        txid, vout = args.txid, args.vout
    else:
        print("sending %s of %s to %s" % (U.fmt(amount), sale["terms"]["token_asset"], addr))
        txid, hexed = _send_explicit(
            addr, amount, args.asset_label or sale["terms"]["token_asset"], fee_asset)
        raw = node("decoderawtransaction", hexed)
        vout = next((o["n"] for o in raw["vout"]
                     if o.get("scriptPubKey", {}).get("hex") == sale["script_pubkey"]), None)
        if vout is None:
            raise Fail("funded %s but could not find the covenant output" % txid)
    api("POST", "/api/projects/%s/lock" % args.slug, {"txid": txid, "vout": int(vout)}, tok)
    print("locked at %s:%d -- the sale is open" % (txid, int(vout)))


def cmd_buy(args):
    tok = sign_in()
    p = api("GET", "/api/projects/%s" % args.slug)
    sale = p["sale"]
    if args.rail and args.rail.lower() != "usdx":
        raise Fail("the covenant is paid in %s. A BTC purchase is two steps: swap BTC for "
                   "%s over Lightning in your wallet, then run this command."
                   % (_payment_label(p), _payment_label(p)))
    decimals = int(p.get("decimals", 8))
    token_atoms = U.parse(args.tokens, decimals)
    if token_atoms is None:
        raise Fail("--tokens must be a number with at most %d decimal places" % decimals)

    plan = api("POST", "/api/projects/%s/buy" % args.slug, {"token_atoms": token_atoms}, tok)
    print("buying %s %s for %s" % (args.tokens, p["ticker"], U.fmt(plan["payment_atoms"], 8, _payment_label(p))))

    pay_asset = sale["terms"]["payment_asset"]
    # A person types a label, because that is what a wallet shows them. levod
    # resolves one too, but the input selection below needs the id.
    fee_asset = resolve_asset(args.fee_asset) if args.fee_asset else pay_asset
    fee_atoms = int(args.fee) if args.fee is not None else int(
        plan.get("fee", {}).get("suggested_atoms") or 0)
    if fee_atoms <= 0:
        raise Fail("this levod could not suggest a fee (its node did not answer "
                   "with an exchange rate); pass --fee with a number of atoms")
    if fee_asset == pay_asset:
        ins, _ = unblinded_inputs(pay_asset, plan["payment_atoms"] + fee_atoms)
    else:
        # Fees are payable in any asset the network accepts, so the fee may
        # come from outputs of its own. They are separate inputs: a purchase
        # spends the payment asset, and this spends whatever pays the fee.
        ins, _ = unblinded_inputs(pay_asset, plan["payment_atoms"])
        fee_ins, _ = unblinded_inputs(fee_asset, fee_atoms)
        seen = {(i["txid"], i["vout"]) for i in ins}
        ins = ins + [i for i in fee_ins if (i["txid"], i["vout"]) not in seen]

    dest = args.to or node("getnewaddress", "levo-buy")
    change = args.change or dest

    built = api("POST", "/api/projects/%s/transaction" % args.slug, {
        "token_atoms": token_atoms,
        "buyer": {"token_address": dest, "change_address": change,
                  "inputs": ins, "fee_atoms": fee_atoms, "fee_asset": fee_asset}}, tok)

    signed = node("signrawtransactionwithwallet", built["unsigned_tx_hex"])
    if not signed.get("complete"):
        raise Fail("your wallet could not sign every input: %s" % signed.get("errors"))
    check = node("testmempoolaccept", [signed["hex"]])
    if not check or not check[0].get("allowed"):
        raise Fail("the chain would reject this: %s"
                   % (check[0].get("reject-reason") if check else "unknown"))
    if args.dry_run:
        print("would broadcast %s (accepted by testmempoolaccept, %s fee)"
              % (built["txid"], U.fmt(fee_atoms, 8,
                                      _payment_label(p) if fee_asset == pay_asset
                                      else fee_asset[:8])))
        return
    txid = node("sendrawtransaction", signed["hex"])
    print("bought. %s" % txid)
    # The purchase is on chain now. Recording it against your allocation is a
    # bookkeeping step, so a failure here is worth saying out loud but must not
    # be reported as a failed purchase.
    _record(args.slug, txid, token_atoms, plan["payment_atoms"], tok)


def _record(slug, txid, token_atoms, payment_atoms, tok, tries=5):
    """Tell Levo about a purchase, patiently.

    Levo reads its own node, which is not the node the transaction was
    broadcast to, so for a few seconds after a broadcast it has not heard of it
    yet. That is not a failure: the purchase is on chain either way and the
    sale moves without any of this. Only the allocation ledger is at stake, so
    it is worth a handful of tries before giving up -- and worth saying, when
    it does give up, exactly how to finish it later.
    """
    body = {"txid": txid, "token_atoms": token_atoms, "payment_atoms": payment_atoms}
    last = None
    for attempt in range(tries):
        try:
            api("POST", "/api/projects/%s/confirm" % slug, body, tok)
            return True
        except SystemExit as e:
            last = str(e)
            if "has not seen" not in last:
                break
            if attempt < tries - 1:
                time.sleep(2)
    print("note: the purchase is on chain, and recording it against your "
          "allocation did not go through (%s).\n"
          "      Finish it whenever you like with:\n"
          "        levo record %s --txid %s --tokens %s"
          % (last, slug, txid, _units(token_atoms)), file=sys.stderr)
    return False


def cmd_record(args):
    """Record a purchase that was made outside this command, or one whose
    record did not go through at the time."""
    tok = sign_in()
    p = api("GET", "/api/projects/%s" % args.slug)
    sale = p["sale"]
    decimals = p.get("decimals", 8)
    token_atoms = U.parse(args.tokens, decimals)
    if token_atoms is None or token_atoms <= 0:
        raise Fail("--tokens must be a number with at most %d decimal places" % decimals)
    payment_atoms = int(args.payment) if args.payment is not None else \
        -(-token_atoms * int(sale["terms"]["price_num"]) // int(sale["terms"]["price_den"]))
    if not _record(args.slug, args.txid.lower(), token_atoms, payment_atoms, tok):
        # The purchase may well be real; this command exists to record one, and
        # it did not, so it says so in the way a script can act on.
        raise Fail("the purchase was not recorded")
    print("recorded %s against your allocation in %s" % (args.txid, args.slug))


def cmd_rescue(args):
    """Reclaim a sale from its terms alone, with no Levo at all.

    A sale is a covenant on a public chain; Levo is a place that shows it. If
    the platform is gone -- the state file lost, the server retired, the
    operator vanished -- the tokens are still there and the project's key still
    opens the reclaim path. What is needed is the terms the address was made
    of, which is exactly what `levo terms` writes out and what every sale page
    publishes. This rebuilds the covenant from them, finds what is resting at
    that address on your own node, and sweeps it.
    """
    import secp256k1 as S  # noqa: E402
    import tx as TXMOD  # noqa: E402
    spec = json.loads(Path(args.terms).read_text())
    terms_json = spec.get("terms", spec)
    terms = C.SaleTerms.from_json(terms_json)
    cov = C.derive(terms)
    addr = ADDR.from_script_pubkey(cov.spk_hex, args.hrp)
    print("sale address   %s" % addr)

    key = args.reclaim_key or os.environ.get("LEVO_RECLAIM_KEY")
    if not key:
        raise Fail("pass --reclaim-key <32-byte hex>, or set LEVO_RECLAIM_KEY: "
                   "the covenant will not open without it")

    scan = node("scantxoutset", "start", ["raw(%s)" % cov.spk_hex])
    if not scan or not scan.get("success"):
        raise Fail("your node could not scan for the sale's outputs")
    resting = [u for u in scan.get("unspents") or []
               if (u.get("asset") or "").lower() == terms.token_asset]
    if not resting:
        raise Fail("nothing of %s is resting at %s; there is nothing to reclaim"
                   % (terms.token_asset[:12], addr))
    biggest = max(resting, key=lambda u: atoms(u.get("amount", 0)))
    held = atoms(biggest.get("amount", 0))
    print("resting        %s at %s:%d" % (U.fmt(held), biggest["txid"], biggest["vout"]))

    sale = S_MOD.Sale("rescue", terms, "rescue")
    sale.confirm_lock(biggest["txid"], int(biggest["vout"]), cov.spk_hex, held,
                      terms.token_asset)
    dest = args.to or node("getnewaddress", "levo-rescue")
    dest_spk = ADDR.to_script_pubkey(dest, args.hrp).hex()
    fee_asset = resolve_asset(args.fee_asset) if args.fee_asset else terms.payment_asset
    fee_atoms = int(args.fee)
    fee_ins, _ = unblinded_inputs(fee_asset, fee_atoms)
    ins = []
    for i in fee_ins:
        out = node("gettxout", i["txid"], int(i["vout"]), True)
        if not out:
            raise Fail("fee input %s:%s is not unspent" % (i["txid"], i["vout"]))
        ins.append({"txid": i["txid"], "vout": int(i["vout"]),
                    "asset": (out.get("asset") or "").lower(),
                    "value_atoms": atoms(out.get("value", 0)),
                    "script_pubkey": (out.get("scriptPubKey") or {}).get("hex")})
    built = TXMOD.build_reclaim(sale, destination_spk=dest_spk, fee_inputs=ins,
                                fee_atoms=fee_atoms, fee_asset=fee_asset,
                                genesis_hash=node("getblockhash", 0),
                                locktime=args.locktime)
    sig = S.schnorr_sign(bytes.fromhex(built["sighash"]), int(key, 16))
    if not S.schnorr_verify(bytes.fromhex(built["sighash"]), sig,
                            bytes.fromhex(terms.reclaim_xonly)):
        raise Fail("that key is not this sale's reclaim key (%s)" % terms.reclaim_xonly)
    hexed = built["unsigned_tx_hex"]
    if ins:
        hexed = node("signrawtransactionwithwallet", hexed).get("hex") or hexed
    hexed = TXMOD.set_witness(hexed, 0, TXMOD.reclaim_witness(sale, sig))
    check = node("testmempoolaccept", [hexed])
    if not check or not check[0].get("allowed"):
        raise Fail("the chain would reject this reclaim: %s"
                   % (check[0].get("reject-reason") if check else "unknown"))
    if args.dry_run:
        print("would broadcast %s (accepted by testmempoolaccept)" % check[0]["txid"])
        return
    print("reclaimed. %s" % node("sendrawtransaction", hexed))


def cmd_terms(args):
    """Write out everything needed to rebuild a sale without Levo.

    A funded sale whose terms are lost can be seen on chain by anyone and
    reclaimed by nobody: the address is made of the terms, and so are the
    leaves the reclaim spends through. Keeping this file beside the reclaim key
    is the difference between a platform outage and a loss.
    """
    p = api("GET", "/api/projects/%s" % args.slug)
    sale = p.get("sale")
    if not sale:
        raise Fail("this project has no sale")
    out = {
        "slug": p["slug"],
        "sale_address": p.get("address"),
        "script_pubkey": sale["script_pubkey"],
        "terms": sale["terms"],
        "keep": "these terms make the sale address, and the reclaim leaf the "
                "project's key spends through. With this file, your reclaim key "
                "and any Sequentia node, `levo rescue --terms <this file>` "
                "sweeps whatever is left at that address after the close -- with "
                "no Levo involved at all.",
    }
    text = json.dumps(out, indent=2, sort_keys=True)
    if args.out:
        Path(args.out).write_text(text + "\n")
        print("wrote %s" % args.out)
    else:
        print(text)


def cmd_reclaim(args):
    tok = sign_in()
    p = api("GET", "/api/projects/%s" % args.slug)
    sale = p["sale"]
    dest = args.to or node("getnewaddress", "levo-reclaim")
    # The reclaim's own shape decides the floor, and levod measures it. A
    # figure typed here was only ever a guess at what the node would relay.
    fee_atoms = int(args.fee) if args.fee is not None else int(
        (api("GET", "/api/projects/%s/fee?kind=reclaim&inputs=2" % args.slug) or {})
        .get("suggested_atoms") or 0)
    if fee_atoms <= 0:
        raise Fail("this levod could not suggest a fee (its node did not answer "
                   "with an exchange rate); pass --fee with a number of atoms")
    fee_asset = (resolve_asset(args.fee_asset) if args.fee_asset
                 else sale["terms"]["payment_asset"])
    ins, _ = unblinded_inputs(fee_asset, fee_atoms)
    r = api("POST", "/api/projects/%s/reclaim" % args.slug, {
        "destination_address": dest,
        "fee_inputs": ins, "fee_atoms": fee_atoms, "fee_asset": fee_asset}, tok)

    key = args.reclaim_key or os.environ.get("LEVO_RECLAIM_KEY")
    if not key:
        print("sighash %s" % r["sighash"])
        print("sign it with the reclaim key (%s), put [signature, leaf, control "
              "block] in input 0, sign your fee inputs and broadcast."
              % r["signs_with"])
        print(json.dumps({k: r[k] for k in ("leaf", "control_block", "locktime",
                                            "unsigned_tx_hex", "txid")}, indent=2))
        print("\nOr pass --reclaim-key <32-byte hex> to finish it here.")
        return

    # Sign the covenant input locally. The key never leaves this machine, and
    # levod is never asked for it -- it could not use one if it had it.
    import secp256k1 as S  # noqa: E402
    import tx as TXMOD  # noqa: E402
    sec = int(key, 16)
    sig = S.schnorr_sign(bytes.fromhex(r["sighash"]), sec)
    if not S.schnorr_verify(bytes.fromhex(r["sighash"]), sig,
                            bytes.fromhex(r["signs_with"])):
        raise Fail("that key is not this sale's reclaim key (%s); the covenant "
                   "would reject the spend" % r["signs_with"])
    witness = [sig, bytes.fromhex(r["leaf"]), bytes.fromhex(r["control_block"])]
    hexed = r["unsigned_tx_hex"]
    if ins:
        signed = node("signrawtransactionwithwallet", hexed)
        hexed = signed.get("hex") or hexed
    hexed = TXMOD.set_witness(hexed, 0, witness)
    check = node("testmempoolaccept", [hexed])
    if not check or not check[0].get("allowed"):
        raise Fail("the chain would reject this reclaim: %s"
                   % (check[0].get("reject-reason") if check else "unknown"))
    if args.dry_run:
        print("would broadcast %s (accepted by testmempoolaccept)" % check[0]["txid"])
        return
    print("reclaimed. %s" % node("sendrawtransaction", hexed))


def cmd_flag(args):
    """Take a listing off the board, or put a notice on its page.

    An operator's reach is the page and nothing else: the sale is a covenant on
    a public chain, and anyone holding its terms can still buy from it.
    """
    tok = sign_in()
    body = {}
    if args.hide:
        body["hidden"] = True
    if args.show:
        body["hidden"] = False
    if args.notice is not None:
        body["notice"] = args.notice
    if not body:
        raise Fail("say what to change: --hide, --show, or --notice \"...\"")
    r = api("POST", "/api/projects/%s/flag" % args.slug, body, tok)
    print("%s: %s%s" % (r["slug"], "off the board" if r["hidden"] else "on the board",
                        ", notice: %s" % r["notice"] if r.get("notice") else ""))
    print(r["reaches"])


def cmd_withdraw(args):
    tok = sign_in()
    api("DELETE", "/api/projects/%s" % args.slug, token=tok)
    print("withdrawn %s" % args.slug)


def main():
    ap = argparse.ArgumentParser(prog="levo", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sl = sub.add_parser("sales")
    sl.set_defaults(fn=cmd_sales)
    sh = sub.add_parser("show"); sh.add_argument("slug"); sh.set_defaults(fn=cmd_show)
    vf = sub.add_parser("verify"); vf.add_argument("slug"); vf.set_defaults(fn=cmd_verify)
    sub.add_parser("whoami").set_defaults(fn=cmd_whoami)
    sub.add_parser("keygen").set_defaults(fn=cmd_keygen)

    ln = sub.add_parser("link")
    ln.add_argument("--pubkey", help="the 33-byte staking key, hex")
    ln.add_argument("--address", help="a legacy address of that key in your wallet, to sign with")
    ln.add_argument("--wif", help="or the key's WIF, to sign with signmessagewithprivkey")
    ln.set_defaults(fn=cmd_link)

    sl.add_argument("--status", default="all",
                    choices=["all", "open", "draft", "finished"],
                    help="which sales to list (default: all)")
    sl.add_argument("--limit", type=int, default=50, help="how many to show")
    sl.add_argument("--offset", type=int, default=0, help="where to start")

    tm = sub.add_parser("terms", help="write out what rebuilds a sale without Levo")
    tm.add_argument("slug")
    tm.add_argument("--out", help="write to this file instead of standard output")
    tm.set_defaults(fn=cmd_terms)

    rs = sub.add_parser("rescue", help="reclaim from the terms alone, with no Levo")
    rs.add_argument("--terms", required=True, help="a file from `levo terms`")
    rs.add_argument("--reclaim-key", help="32-byte hex; the key the covenant waits for")
    rs.add_argument("--to", help="where the tokens go (default: a new wallet address)")
    rs.add_argument("--fee", type=int, default=1000, help="fee in atoms of the fee asset")
    rs.add_argument("--fee-asset", help="asset to pay the fee in")
    rs.add_argument("--hrp", default="tb", help="the chain's address prefix")
    rs.add_argument("--locktime", type=int, help="override the reclaim's locktime")
    rs.add_argument("--dry-run", action="store_true")
    rs.set_defaults(fn=cmd_rescue)

    rd = sub.add_parser("record", help="tell Levo about a purchase it has not recorded")
    rd.add_argument("slug")
    rd.add_argument("--txid", required=True, help="the purchase transaction")
    rd.add_argument("--tokens", required=True, help="how many tokens it bought")
    rd.add_argument("--payment", type=int,
                    help="what it paid, in atoms (default: the covenant's price)")
    rd.set_defaults(fn=cmd_record)

    fg = sub.add_parser("flag", help="operator: hide a listing or put a notice on it")
    fg.add_argument("slug")
    fg.add_argument("--hide", action="store_true", help="take it off the board")
    fg.add_argument("--show", action="store_true", help="put it back")
    fg.add_argument("--notice", help="a line shown at the top of its page")
    fg.set_defaults(fn=cmd_flag)

    cr = sub.add_parser("create")
    cr.add_argument("file", nargs="?", help="a JSON file holding {project, terms}")
    cr.add_argument("--example", action="store_true",
                    help="print a listing file to start from, and what each field means")
    cr.set_defaults(fn=cmd_create)

    lk = sub.add_parser("lock")
    lk.add_argument("slug"); lk.add_argument("--atoms", type=int)
    lk.add_argument("--asset-label", help="label or hex id the node knows the token by "
                                          "(default: the sale's token id)")
    lk.add_argument("--fee-asset", help="asset to pay the fee in (default: the sale's payment asset)")
    lk.add_argument("--txid", help="confirm an output you already sent instead of sending")
    lk.add_argument("--vout", type=int, default=0)
    lk.set_defaults(fn=cmd_lock)

    b = sub.add_parser("buy")
    b.add_argument("slug"); b.add_argument("--tokens", required=True)
    b.add_argument("--rail", default="usdx")
    b.add_argument("--fee", type=int, help="fee in atoms of the fee asset (default: levod's suggestion)")
    b.add_argument("--fee-asset", help="asset to pay the fee in (default: the sale's payment asset)")
    b.add_argument("--to"); b.add_argument("--change")
    b.add_argument("--dry-run", action="store_true")
    b.set_defaults(fn=cmd_buy)

    rc = sub.add_parser("reclaim")
    rc.add_argument("slug"); rc.add_argument("--to")
    rc.add_argument("--fee", type=int, help="fee in atoms of the fee asset (default: levod's suggestion)")
    rc.add_argument("--fee-asset", help="asset to pay the fee in (default: the sale's payment asset)")
    rc.add_argument("--reclaim-key", help="32-byte hex; signs the covenant here")
    rc.add_argument("--dry-run", action="store_true")
    rc.set_defaults(fn=cmd_reclaim)

    wd = sub.add_parser("withdraw"); wd.add_argument("slug"); wd.set_defaults(fn=cmd_withdraw)

    args = ap.parse_args()
    rc = args.fn(args)
    sys.exit(rc or 0)


if __name__ == "__main__":
    main()
